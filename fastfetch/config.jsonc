{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/master/doc/json_schema.json",
    "display": {
    "separator": "    ",
    "color": {
      "keys": "cyan",
      "title": "red",
      "output": "default",
      "separator": "default"
    },
    "key": {
      "type": "string",
      "width": 25
    },
    "hideCursor": true
  },
  "logo": {
    "type": "small"
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "os",
      "format": "{1} {2} ({3})"
    },
    {
      "type": "kernel"
    },
    {
      "type": "locale"
    },
    {
      "type": "uptime"
    },
    {
      "type": "shell"
    },
    {
      "type": "terminal"
    },
    {
      "type": "disk",
      "format": "{1}: {2} / {3} ({4}%)",
      "folders": [
        "C:\\",
        "/mnt/c"
      ]
    },
    {
      "type": "datetime",
      "format": "{day-pretty}-{month-pretty}-{year} {hour-pretty}:{minute-pretty}:{second-pretty} UTC{offset-from-utc} {timezone-name}"
    },
    {
      "type": "localip"
    }
  ]
}
